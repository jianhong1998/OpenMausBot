# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=openmausbot
OMB_BIND_ADDRESS=127.0.0.1
OMB_HTTP_PORT=8080
# Leave empty to use http://localhost:${OMB_HTTP_PORT:-8080}.
OMB_PUBLIC_URL=
# Leave empty to inherit OMB_PUBLIC_URL.
OMB_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set OMB_PUBLIC_URL to https:// followed by the same hostname.
# Requires OMB_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy,
# or a bind address others can reach plus OMB_TRUSTED_PROXY_CIDRS.
OMB_HTTPS_HOST=
# Name the peers that may claim the HTTPS hostname (CIDRs, space separated).
# Required when OMB_HTTPS_HOST is set with any bind address but 127.0.0.1.
# Empty keeps the default: only the host itself can reach a loopback bind.
OMB_TRUSTED_PROXY_CIDRS=
OMB_BASE_IMAGE=ghcr.io/milind-soni/openmausbot:latest
OMB_LOCAL_IMAGE=openmausbot-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Host path for the data directory (bind-mounted to /data). Must be an absolute path so the host
# Docker daemon can resolve it when spawning Local VM desktop containers.
OMB_DATA_PATH=/var/lib/openmausbot/data
# Host-absolute path to the .openmausbot subdirectory inside OMB_DATA_PATH.
# Used as the bind mount source for Local VM desktop containers (spawned by the host daemon).
# Must equal the absolute expansion of: ${OMB_DATA_PATH}/.openmausbot
OMB_HOST_DATA_DIR=/var/lib/openmausbot/data/.openmausbot
# Docker socket path (host-side). Default /var/run/docker.sock works for Docker Engine on Linux.
# OrbStack on macOS: DOCKER_SOCK=~/.orbstack/run/docker.sock
DOCKER_SOCK=/var/run/docker.sock
# GID of the docker group on the host (so the omb container can reach the socket).
# Linux Docker Engine default: 999. OrbStack on macOS: 20 (staff group).
# Check with: stat -c %g /var/run/docker.sock
DOCKER_GID=999
